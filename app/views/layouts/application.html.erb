<!DOCTYPE html>
<html>
  <head>
    <title>JobTrack</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <div class="container navbar-inner">
        <%= link_to "JobTrack", root_path, class: "brand" %>

        <nav>
          <%= link_to "Applications", jobs_path %>
          <%= link_to "Add Job", new_job_path, class: "button button-small" %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice.present? %>
        <div class="notice">
          <%= notice %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
