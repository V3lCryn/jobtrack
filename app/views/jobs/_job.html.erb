<div id="<%= dom_id job %>">
  <div>
    <strong>Company:</strong>
    <%= job.company %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= job.title %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= job.location %>
  </div>

  <div>
    <strong>Salary:</strong>
    <%= job.salary %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= job.status %>
  </div>

  <div>
    <strong>Applied on:</strong>
    <%= job.applied_on %>
  </div>

  <div>
    <strong>Url:</strong>
    <%= job.url %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= job.notes %>
  </div>

</div>
